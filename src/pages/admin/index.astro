---
export const prerender = false;

import Admin from '../../layouts/Admin.astro';
import { isSeedId } from '../../lib/seed';
import { listSubmissoesAdmin, type SubmissaoStatus } from '../../lib/submissoes';

const PAGE_SIZE = 10;

const session = Astro.locals.admin!;
const filtro = (Astro.url.searchParams.get('status') ?? 'todas') as SubmissaoStatus | 'todas';
const todas = await listSubmissoesAdmin();
const filtradas =
	filtro === 'todas' ? todas : todas.filter((item) => item.meta.status === filtro);

const totalPages = Math.max(1, Math.ceil(filtradas.length / PAGE_SIZE));
const pageParam = Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10);
const pagina = Number.isFinite(pageParam) ? Math.min(Math.max(1, pageParam), totalPages) : 1;
const items = filtradas.slice((pagina - 1) * PAGE_SIZE, pagina * PAGE_SIZE);

const contagem = {
	todas: todas.length,
	pendente: todas.filter((i) => i.meta.status === 'pendente').length,
	aprovada: todas.filter((i) => i.meta.status === 'aprovada').length,
	rejeitada: todas.filter((i) => i.meta.status === 'rejeitada').length,
};

const labels: Record<SubmissaoStatus | 'todas', string> = {
	todas: 'Todas',
	pendente: 'Pendentes',
	aprovada: 'Aprovadas',
	rejeitada: 'Rejeitadas',
};

function statusClass(status: SubmissaoStatus) {
	if (status === 'aprovada') return 'bg-forest/10 text-forest';
	if (status === 'rejeitada') return 'bg-clay/10 text-clay';
	return 'bg-ochre/10 text-ochre';
}

function formatDate(iso: string) {
	const d = new Date(iso);
	if (Number.isNaN(d.valueOf())) return iso;
	return d.toLocaleString('pt-BR', { timeZone: 'UTC' });
}

function adminHref(options: { status?: typeof filtro; page?: number }) {
	const params = new URLSearchParams();
	const status = options.status ?? filtro;
	if (status !== 'todas') params.set('status', status);
	if (options.page && options.page > 1) params.set('page', String(options.page));
	const query = params.toString();
	return query ? `/admin?${query}` : '/admin';
}

const from = filtradas.length === 0 ? 0 : (pagina - 1) * PAGE_SIZE + 1;
const to = Math.min(pagina * PAGE_SIZE, filtradas.length);
---

<Admin title="Contribuições" user={session.user}>
	<div class="flex flex-wrap items-end justify-between gap-4">
		<div>
			<p class="text-xs uppercase tracking-[0.22em] text-ochre">revisão</p>
			<h1 class="mt-2 font-serif text-4xl tracking-tight md:text-5xl">Contribuições</h1>
			<p class="mt-3 max-w-xl text-ink/65">
				Aprove para publicar no arquivo, rejeite ou apague envios. O crédito do autor na ficha pública é opcional.
			</p>
		</div>
		<p class="text-sm text-ink/50">{contagem.pendente} pendente{contagem.pendente === 1 ? '' : 's'}</p>
	</div>

	<nav class="mt-8 flex flex-wrap gap-2" aria-label="Filtro de status">
		{
			(['todas', 'pendente', 'aprovada', 'rejeitada'] as const).map((key) => (
				<a
					href={adminHref({ status: key, page: 1 })}
					class:list={[
						'rounded-full px-4 py-2 text-sm transition',
						filtro === key
							? 'bg-ink text-paper'
							: 'border border-ink/15 text-ink/70 hover:border-ochre hover:text-ochre',
					]}
				>
					{labels[key]} ({contagem[key]})
				</a>
			))
		}
	</nav>

	<div id="admin-flash" class="mt-6"></div>

	{
		filtradas.length === 0 ? (
			<p class="mt-10 rounded-3xl border border-dashed border-ink/15 px-6 py-16 text-center text-ink/55">
				Nenhuma contribuição neste filtro.
			</p>
		) : (
			<>
				<p class="mt-8 text-sm text-ink/50">
					Mostrando {from}–{to} de {filtradas.length}
				</p>
				<ul class="mt-4 grid gap-5">
					{items.map((item) => (
					<li class="rounded-3xl border border-ink/10 bg-white/50 p-5 md:p-6">
						<div class="flex flex-wrap items-start justify-between gap-3">
							<div>
								<p class="text-[11px] uppercase tracking-[0.18em] text-ink/45">
									{item.cidade}
									{item.uf ? `, ${item.uf}` : ''} · {formatDate(item.meta.savedAt)}
									{isSeedId(item.id) ? ' · acervo seed' : ''}
								</p>
								<h2 class="mt-2 font-serif text-2xl tracking-tight">{item.nome}</h2>
								<p class="mt-1 text-sm text-ink/55">
									{isSeedId(item.id)
										? 'Conteúdo de teste do acervo'
										: item.autor
											? `Por ${item.autor}`
											: 'Autor não informado'}
									{!isSeedId(item.id) && item.meta.email ? ` · ${item.meta.email}` : ''}
								</p>
								<p class="mt-1 text-xs text-ink/45">
									Crédito na ficha: {item.creditoPublico ? 'nome visível' : 'contribuição anônima'}
								</p>
							</div>
							<span
								class:list={[
									'rounded-full px-3 py-1 text-xs uppercase tracking-wider',
									statusClass(item.meta.status),
								]}
							>
								{item.meta.status}
							</span>
						</div>

						{
							item.resumo && (
								<p class="mt-4 text-sm leading-relaxed text-ink/75">{item.resumo}</p>
							)
						}

						{
							item.imagemUrl && (
								<img
									src={item.imagemUrl}
									alt={`Imagem de ${item.nome}`}
									class="mt-4 aspect-[16/9] max-w-md rounded-2xl object-cover"
								/>
							)
						}

						<details class="mt-4">
							<summary class="cursor-pointer text-sm text-ochre">Ver texto completo</summary>
							<pre class="mt-3 max-h-64 overflow-auto rounded-2xl bg-ink px-4 py-3 text-xs leading-relaxed text-paper/90">{item.markdown}</pre>
						</details>

						<div class="mt-5 flex flex-wrap gap-2">
							{
								item.meta.status !== 'aprovada' && (
									<button
										type="button"
										class="rounded-full bg-forest px-4 py-2 text-sm text-paper transition hover:opacity-90"
										hx-post={`/api/admin/submissoes/${item.id}`}
										hx-vals='{"action":"aprovar"}'
										hx-target="#admin-flash"
										hx-swap="innerHTML"
									>
										Aprovar
									</button>
								)
							}
							{
								item.meta.status !== 'rejeitada' && (
									<button
										type="button"
										class="rounded-full border border-ink/15 px-4 py-2 text-sm transition hover:border-clay hover:text-clay"
										hx-post={`/api/admin/submissoes/${item.id}`}
										hx-vals='{"action":"rejeitar"}'
										hx-target="#admin-flash"
										hx-swap="innerHTML"
									>
										Rejeitar
									</button>
								)
							}
							{
								item.creditoPublico ? (
									<button
										type="button"
										class="rounded-full border border-ink/15 px-4 py-2 text-sm transition hover:border-ochre hover:text-ochre"
										hx-post={`/api/admin/submissoes/${item.id}`}
										hx-vals='{"action":"credito-anonimo"}'
										hx-target="#admin-flash"
										hx-swap="innerHTML"
									>
										Ocultar crédito
									</button>
								) : (
									<button
										type="button"
										class="rounded-full border border-ink/15 px-4 py-2 text-sm transition hover:border-ochre hover:text-ochre"
										hx-post={`/api/admin/submissoes/${item.id}`}
										hx-vals='{"action":"credito-publico"}'
										hx-target="#admin-flash"
										hx-swap="innerHTML"
									>
										Mostrar crédito
									</button>
								)
							}
							{
								item.meta.status === 'aprovada' && (
									<a
										href={`/bandas/${item.id}`}
										class="rounded-full border border-ink/15 px-4 py-2 text-sm transition hover:border-ochre hover:text-ochre"
										target="_blank"
										rel="noopener noreferrer"
									>
										Ver no site
									</a>
								)
							}
							<button
								type="button"
								class="rounded-full border border-clay/30 px-4 py-2 text-sm text-clay transition hover:bg-clay/10"
								hx-post={`/api/admin/submissoes/${item.id}`}
								hx-vals='{"action":"excluir"}'
								hx-confirm="Apagar esta contribuição permanentemente?"
								hx-target="#admin-flash"
								hx-swap="innerHTML"
							>
								Excluir
							</button>
						</div>
					</li>
					))}
				</ul>

				{
					totalPages > 1 && (
						<nav class="mt-10 flex flex-wrap items-center justify-between gap-4" aria-label="Paginação">
							<a
								href={pagina > 1 ? adminHref({ page: pagina - 1 }) : undefined}
								aria-disabled={pagina <= 1 ? 'true' : undefined}
								class:list={[
									'rounded-full border px-4 py-2 text-sm transition',
									pagina <= 1
										? 'pointer-events-none border-ink/10 text-ink/30'
										: 'border-ink/15 text-ink/70 hover:border-ochre hover:text-ochre',
								]}
							>
								Anterior
							</a>
							<p class="text-sm text-ink/55">
								Página {pagina} de {totalPages}
							</p>
							<a
								href={pagina < totalPages ? adminHref({ page: pagina + 1 }) : undefined}
								aria-disabled={pagina >= totalPages ? 'true' : undefined}
								class:list={[
									'rounded-full border px-4 py-2 text-sm transition',
									pagina >= totalPages
										? 'pointer-events-none border-ink/10 text-ink/30'
										: 'border-ink/15 text-ink/70 hover:border-ochre hover:text-ochre',
								]}
							>
								Próxima
							</a>
						</nav>
					)
				}
			</>
		)
	}
</Admin>
