---
export const prerender = false;

import Admin from '../../layouts/Admin.astro';
import { getAdminSession } from '../../lib/admin-auth';

const session = await getAdminSession(Astro.request);
if (session) {
	return Astro.redirect('/admin');
}

const erro = Astro.url.searchParams.get('erro');
---

<Admin title="Entrar">
	<section class="mx-auto max-w-md">
		<p class="text-xs uppercase tracking-[0.22em] text-ochre">acesso restrito</p>
		<h1 class="mt-3 font-serif text-4xl tracking-tight">Moderar contribuições.</h1>
		<p class="mt-4 text-ink/65">Entre com o usuário e a senha do painel.</p>

		{
			erro && (
				<p class="mt-6 rounded-2xl border border-clay/20 bg-clay/10 px-4 py-3 text-sm text-clay">
					{erro === 'credenciais' ? 'Usuário ou senha inválidos.' : 'Não foi possível entrar.'}
				</p>
			)
		}

		<form method="post" action="/api/admin/login" class="mt-8 grid gap-4">
			<label class="grid gap-2 text-sm">
				<span>Usuário</span>
				<input
					required
					name="username"
					autocomplete="username"
					class="rounded-xl border border-ink/15 bg-white px-4 py-3 outline-none focus:border-ochre"
				/>
			</label>
			<label class="grid gap-2 text-sm">
				<span>Senha</span>
				<input
					required
					name="password"
					type="password"
					autocomplete="current-password"
					class="rounded-xl border border-ink/15 bg-white px-4 py-3 outline-none focus:border-ochre"
				/>
			</label>
			<button
				type="submit"
				class="mt-2 inline-flex items-center justify-center rounded-full bg-ochre px-6 py-3 text-sm font-medium text-paper transition hover:bg-ochre-hot"
			>
				Entrar
			</button>
		</form>
	</section>
</Admin>
