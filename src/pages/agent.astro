---
export const prerender = false;

import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
---

<Base title="Agente" description="Converse com o agente MCP para cadastrar bandas por texto ou imagem, com prévia e aprovação antes de publicar.">
	<section class="mx-auto flex min-h-[calc(100dvh-8rem)] w-full max-w-3xl flex-col px-4 py-8 md:px-6">
		<header class="mb-6">
			<p class="text-xs uppercase tracking-[0.22em] text-ochre">MCP · agente</p>
			<h1 class="mt-2 font-serif text-4xl tracking-tight md:text-5xl">Cadastre uma banda em conversa.</h1>
			<p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink/65">
				Envie texto e uma coleção de imagens (flyer, fotos, prints). O agente monta a ficha, mostra a
				prévia e só grava no acervo quando você responder <strong>sim</strong>.
			</p>
		</header>

		<div
			id="agent-app"
			class="flex min-h-0 flex-1 flex-col overflow-hidden rounded-3xl border border-ink/10 bg-white/70 shadow-sm backdrop-blur"
			x-data="agentChat()"
		>
			<div
				id="agent-messages"
				class="flex-1 space-y-4 overflow-y-auto px-4 py-5 md:px-6"
				x-ref="scroller"
			>
				<div class="rounded-2xl bg-ink/[0.04] px-4 py-3 text-sm leading-relaxed text-ink/75">
					Olá — sou o agente do Mapa Bandas. Cole a história de uma banda e anexe várias imagens ao
					mesmo relatório. Eu devolvo a prévia; diga <span class="font-medium text-ochre">sim</span> para publicar.
				</div>

				<template x-for="(msg, i) in messages" :key="i">
					<div
						class="max-w-[92%] rounded-2xl px-4 py-3 text-sm leading-relaxed whitespace-pre-wrap"
						:class="msg.role === 'user'
							? 'ml-auto bg-ink text-paper'
							: 'bg-paper-muted/80 text-ink'"
						x-text="msg.content"
					></div>
				</template>

				<div x-show="loading" x-cloak class="text-xs uppercase tracking-[0.16em] text-ink/40">
					Pensando…
				</div>
			</div>

			<form class="border-t border-ink/10 p-4 md:p-5" @submit.prevent="send">
				<div class="mb-3 flex flex-wrap items-center gap-2" x-show="images.length" x-cloak>
					<template x-for="(img, index) in images" :key="index">
						<span class="inline-flex items-center gap-2 rounded-full bg-ochre/10 px-3 py-1 text-xs text-ochre">
							<Icon name="lucide:image" class="size-3.5" />
							<span class="max-w-[10rem] truncate" x-text="img.name"></span>
							<button
								type="button"
								class="text-ochre/70 hover:text-ochre"
								@click="removeImage(index)"
								aria-label="Remover imagem"
							>
								<Icon name="lucide:x" class="size-3.5" />
							</button>
						</span>
					</template>
					<button type="button" class="text-xs text-ink/50 hover:text-ink" @click="clearImages">
						Limpar
					</button>
				</div>

				<div class="flex items-end gap-2">
					<label
						class="inline-flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-full border border-ink/15 text-ink/60 hover:border-ochre/40 hover:text-ochre"
						title="Anexar imagens"
					>
						<Icon name="lucide:image-plus" class="size-5" />
						<input type="file" accept="image/*" multiple class="sr-only" @change="onFile($event)" />
					</label>
					<textarea
						x-model="input"
						rows="2"
						placeholder="Ex.: A banda Serra Elétrica, de Fortaleza/CE, formada em 2015…"
						class="min-h-[2.75rem] flex-1 resize-none rounded-2xl border border-ink/15 bg-white px-4 py-3 text-sm outline-none focus:border-ochre"
						@keydown.enter.meta.prevent="send()"
						@keydown.enter.ctrl.prevent="send()"
					></textarea>
					<button
						type="submit"
						class="inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-ink text-paper hover:bg-ochre disabled:opacity-40"
						:disabled="loading || (!input.trim() && images.length === 0)"
						aria-label="Enviar"
					>
						<Icon name="lucide:send" class="size-4" />
					</button>
				</div>
				<p class="mt-2 text-[11px] text-ink/45">
					Até 8 imagens por relatório · Ctrl/⌘ + Enter para enviar.
				</p>
			</form>
		</div>
	</section>
</Base>
