---
export const prerender = false;

import { Icon } from 'astro-icon/components';
import { PUBLIC_MAPBOX_TOKEN } from 'astro:env/client';
import MapaLayout from '../layouts/Mapa.astro';
import { getBandas, toMapaFeatures } from '../lib/bandas';
import { getPublicMapboxToken } from '../lib/mapbox-token';

const bandas = await getBandas();
const geojson = toMapaFeatures(bandas);
const mapboxToken = getPublicMapboxToken(PUBLIC_MAPBOX_TOKEN);
const formacoes = bandas.map((banda) => banda.data.formacao);
const anoAtual = new Date().getFullYear();
const anoMin = formacoes.length ? Math.min(...formacoes) : 1900;
const anoMax = formacoes.length ? Math.max(...formacoes) : anoAtual;
---

<MapaLayout title="Mapa" description="Mapa em tela cheia das bandas locais do Brasil. Dê zoom para revelar os pontos e abra o arquivo de cada cidade.">
	<div class="absolute inset-0 z-0">
		<div id="mapa" class="h-full w-full"></div>
	</div>

	<button
		id="filtro-ano-abrir"
		type="button"
		class="pointer-events-auto absolute left-4 top-20 z-20 inline-flex size-11 items-center justify-center rounded-full border border-white/15 bg-ink/80 text-paper shadow-lg backdrop-blur transition hover:border-gold/40 hover:text-gold md:left-6"
		aria-label="Abrir filtro por ano"
		aria-controls="filtro-ano"
		aria-expanded="false"
	>
		<Icon name="lucide:filter" class="size-5" />
	</button>

	<div
		id="filtro-ano"
		class="pointer-events-auto absolute inset-x-0 bottom-0 z-20 flex h-[50dvh] max-h-[50dvh] flex-col rounded-t-3xl border border-white/10 bg-ink/90 p-5 pt-4 text-paper shadow-lg backdrop-blur md:inset-x-auto md:bottom-auto md:left-6 md:top-20 md:h-auto md:max-h-none md:w-full md:max-w-md md:rounded-2xl md:p-4"
		hidden
		role="dialog"
		aria-label="Filtro por ano de formação"
	>
		<button
			id="filtro-ano-fechar"
			type="button"
			class="absolute right-3 top-3 rounded-full p-1.5 text-paper/45 transition hover:bg-white/10 hover:text-paper"
			aria-label="Fechar filtro"
		>
			<Icon name="lucide:x" class="size-4" />
		</button>

		<div class="flex items-end justify-between gap-3 pr-8">
			<div>
				<p class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-gold">
					<Icon name="lucide:calendar-range" class="size-3.5" />
					Formação
				</p>
				<p id="filtro-ano-label" class="mt-1 font-serif text-2xl tracking-tight md:text-2xl">
					{anoMin} – {anoMax}
				</p>
			</div>
			<p id="filtro-ano-contagem" class="pb-1 text-xs uppercase tracking-[0.16em] text-paper/55">
				{bandas.length === 1 ? '1 banda' : `${bandas.length} bandas`}
			</p>
		</div>

		<div class="mt-5 flex min-h-0 flex-1 flex-col justify-center gap-4 md:mt-4 md:flex-none md:justify-start md:gap-0">
			<label class="block">
				<span class="text-[11px] uppercase tracking-[0.16em] text-paper/45">De</span>
				<input
					id="filtro-ano-min"
					class="filtro-ano-range mt-2 w-full"
					type="range"
					min={anoMin}
					max={anoMax}
					value={anoMin}
					step="1"
					aria-label="Ano mínimo de formação"
				/>
			</label>
			<label class="mt-0 block md:mt-3">
				<span class="text-[11px] uppercase tracking-[0.16em] text-paper/45">Até</span>
				<input
					id="filtro-ano-max"
					class="filtro-ano-range mt-2 w-full"
					type="range"
					min={anoMin}
					max={anoMax}
					value={anoMax}
					step="1"
					aria-label="Ano máximo de formação"
				/>
			</label>

			<div class="mt-1 flex justify-between text-[11px] uppercase tracking-[0.16em] text-paper/45">
				<span>{anoMin}</span>
				<span>{anoMax}</span>
			</div>
		</div>
	</div>

	<div
		id="aviso-acervo"
		class="pointer-events-auto absolute bottom-6 left-4 z-20 max-w-sm rounded-2xl border border-white/10 bg-ink/80 p-4 pr-11 text-sm text-paper/80 backdrop-blur md:left-6"
		hidden
	>
		<button
			id="aviso-acervo-fechar"
			type="button"
			class="absolute right-2.5 top-2.5 rounded-full p-1.5 text-paper/45 transition hover:bg-white/10 hover:text-paper"
			aria-label="Fechar aviso"
		>
			<Icon name="lucide:x" class="size-4" />
		</button>
		<p class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-gold">
			<Icon name="lucide:map-pin" class="size-3.5" />
			{bandas.length} bandas no acervo
		</p>
		<p class="mt-2 leading-relaxed">
			Quanto mais zoom, mais pontos aparecem. Clique em um deles para ler o arquivo da banda.
		</p>
	</div>

	<div
		id="mapa-aviso"
		class="absolute inset-0 z-20 hidden place-items-center bg-ink px-6 text-center"
	>
		<div class="max-w-lg">
			<p class="text-xs uppercase tracking-[0.22em] text-gold">mapa</p>
			<h1 id="mapa-aviso-titulo" class="mt-3 font-serif text-4xl">Mapa indisponível</h1>
			<p id="mapa-aviso-texto" class="mt-4 text-paper/70">
				Não foi possível carregar o mapa agora. Volte em instantes ou explore o arquivo pelas bandas.
			</p>
		</div>
	</div>

	<div
		id="modal-banda"
		class="fixed inset-0 z-40 grid place-items-end p-4 md:place-items-center"
		x-data
		x-cloak
		x-show="$store.modal.open"
		x-transition.opacity
		@keydown.escape.window="$store.modal.close()"
	>
		<button class="absolute inset-0 bg-ink/70" type="button" @click="$store.modal.close()" aria-label="Fechar"></button>
		<article
			class="relative w-full max-w-lg rounded-3xl border border-white/10 bg-paper p-6 text-ink shadow-2xl md:p-8"
			x-show="$store.modal.open"
			x-transition
			@click.outside="$store.modal.close()"
			role="dialog"
			aria-modal="true"
			:aria-labelledby="$store.modal.banda ? 'modal-titulo' : null"
		>
			<button
				type="button"
				class="absolute right-4 top-4 rounded-full p-2 text-ink/50 hover:bg-ink/5 hover:text-ink"
				@click="$store.modal.close()"
				aria-label="Fechar"
			>
				<Icon name="lucide:x" class="size-5" />
			</button>
			<template x-if="$store.modal.banda">
				<div>
					<p class="text-[11px] uppercase tracking-[0.22em] text-ochre">
						<span x-text="$store.modal.banda.cidade"></span>,
						<span x-text="$store.modal.banda.uf"></span>
						·
						<span x-text="$store.modal.banda.formacao"></span>
					</p>
					<h2 id="modal-titulo" class="mt-3 font-serif text-4xl tracking-tight" x-text="$store.modal.banda.nome"></h2>
					<p class="mt-2 text-xs uppercase tracking-[0.16em] text-ink/45" x-text="$store.modal.banda.generos"></p>
					<p class="mt-4 text-sm leading-relaxed text-ink/70" x-text="$store.modal.banda.resumo"></p>
					<a
						class="mt-6 inline-flex items-center gap-2 rounded-full bg-ink px-5 py-3 text-sm text-paper hover:bg-ochre"
						:href="$store.modal.banda.url"
					>
						Abrir o artigo
						<Icon name="lucide:arrow-right" class="size-4" />
					</a>
				</div>
			</template>
		</article>
	</div>

	<script is:inline define:vars={{ mapboxToken }}>
		window.__MAPBOX_TOKEN__ = mapboxToken || '';
	</script>
	<script is:inline>
		(function () {
			var KEY = 'mapa-bandas:aviso-acervo-dismissed';
			var aviso = document.getElementById('aviso-acervo');
			var fechar = document.getElementById('aviso-acervo-fechar');
			if (!aviso || !fechar) return;
			try {
				if (localStorage.getItem(KEY) === '1') return;
			} catch (_) {}
			aviso.hidden = false;
			fechar.addEventListener('click', function () {
				aviso.hidden = true;
				try {
					localStorage.setItem(KEY, '1');
				} catch (_) {}
			});
		})();
	</script>
	<script is:inline>
		(function () {
			var painel = document.getElementById('filtro-ano');
			var abrir = document.getElementById('filtro-ano-abrir');
			var fechar = document.getElementById('filtro-ano-fechar');
			if (!painel || !abrir || !fechar) return;

			function setAberto(aberto) {
				painel.hidden = !aberto;
				abrir.hidden = aberto;
				abrir.setAttribute('aria-expanded', aberto ? 'true' : 'false');
			}

			abrir.addEventListener('click', function () {
				setAberto(true);
			});
			fechar.addEventListener('click', function () {
				setAberto(false);
			});
			document.addEventListener('keydown', function (event) {
				if (event.key === 'Escape' && !painel.hidden) setAberto(false);
			});
		})();
	</script>
	<script>
		import { initMapa } from '../scripts/mapa';

		const node = document.getElementById('bandas-geojson');
		const geojson = node
			? JSON.parse(node.textContent || '{"type":"FeatureCollection","features":[]}')
			: { type: 'FeatureCollection', features: [] };
		const anoMin = Number(document.getElementById('filtro-ano-min')?.getAttribute('min') || 1900);
		const anoMax = Number(document.getElementById('filtro-ano-max')?.getAttribute('max') || new Date().getFullYear());
		initMapa({
			token: window.__MAPBOX_TOKEN__ || '',
			geojson,
			anoMin,
			anoMax,
		});
	</script>
	<script type="application/json" id="bandas-geojson" set:html={JSON.stringify(geojson)} />
</MapaLayout>

<style>
	.filtro-ano-range {
		appearance: none;
		height: 0.35rem;
		border-radius: 9999px;
		background: color-mix(in oklab, var(--color-paper) 20%, transparent);
		outline: none;
	}

	.filtro-ano-range::-webkit-slider-thumb {
		appearance: none;
		width: 1.1rem;
		height: 1.1rem;
		border-radius: 9999px;
		border: 2px solid var(--color-paper);
		background: var(--color-ochre);
		cursor: pointer;
		box-shadow: 0 1px 4px rgb(0 0 0 / 0.35);
	}

	.filtro-ano-range::-moz-range-thumb {
		width: 1.1rem;
		height: 1.1rem;
		border-radius: 9999px;
		border: 2px solid var(--color-paper);
		background: var(--color-ochre);
		cursor: pointer;
		box-shadow: 0 1px 4px rgb(0 0 0 / 0.35);
	}

	.filtro-ano-range:focus-visible::-webkit-slider-thumb {
		outline: 2px solid var(--color-gold);
		outline-offset: 2px;
	}

	.filtro-ano-range:focus-visible::-moz-range-thumb {
		outline: 2px solid var(--color-gold);
		outline-offset: 2px;
	}
</style>
