---
import Seo from '../components/Seo.astro';
import '../styles/global.css';

interface Props {
	title?: string;
	user?: string;
}

const { title = 'Admin', user } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<Seo title={`${title} · Admin`} description="Painel de moderação das contribuições." permalink="/admin" />
		<meta name="robots" content="noindex,nofollow" />
	</head>
	<body class="site-bg min-h-dvh font-sans text-ink">
		<header class="border-b border-ink/10 bg-paper/90 backdrop-blur-md">
			<div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4 md:px-6">
				<a href="/admin" class="leading-tight">
					<span class="block font-serif text-lg tracking-tight">Mapa Bandas</span>
					<span class="block text-[11px] uppercase tracking-[0.22em] text-ochre">admin</span>
				</a>
				{
					user && (
						<div class="flex items-center gap-4 text-sm">
							<span class="text-ink/55">{user}</span>
							<form method="post" action="/api/admin/logout">
								<button type="submit" class="text-ochre underline-offset-2 hover:underline">
									Sair
								</button>
							</form>
						</div>
					)
				}
			</div>
		</header>
		<main class="mx-auto max-w-5xl px-4 py-10 md:px-6 md:py-14">
			<slot />
		</main>
		<script>
			import htmx from 'htmx.org';
			window.htmx = htmx;
		</script>
	</body>
</html>
